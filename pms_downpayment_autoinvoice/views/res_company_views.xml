<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_company_form_inherit_downpayment_auto" model="ir.ui.view">
    <field name="name">res.company.form.pms.downpayment.auto</field>
    <field name="model">res.company</field>
    <field name="inherit_id" ref="base.view_company_form" />
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="Downpayment Automation">
          <group>
            <group>
              <field name="downpayment_auto_enabled" />
              <field name="downpayment_auto_mode" />
              <field name="downpayment_auto_batch_size" />
            </group>
            <group attrs="{'invisible':[('downpayment_auto_mode','!=','weekly')]}">
              <field name="downpayment_auto_weekday" required="1" />
            </group>
            <group attrs="{'invisible':[('downpayment_auto_mode','!=','monthly')]}">
              <field name="downpayment_auto_monthly_marker" required="1" />
              <field
                                name="downpayment_auto_monthly_day"
                                attrs="{'required':[('downpayment_auto_monthly_marker','=','fixed')],
                             'invisible':[('downpayment_auto_monthly_marker','!=','fixed')]}"
                            />
            </group>

          </group>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
