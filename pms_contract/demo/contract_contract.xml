<odoo noupdate="1">
    <record id="demo_contract_downtown" model="contract.contract">
        <field name="name">Downtown Apartment – Annual Maintenance</field>
        <field name="partner_id" ref="pms_base.demo_partner_owner" />
        <field name="contract_line_ids">
            <record id="demo_contract_line_cleaning" model="contract.line">
                <field name="name">Monthly Cleaning Service</field>
                <field name="product_id" ref="pms_base.demo_product_cleaning" />
                <field name="quantity">1.0</field>
                <field name="price_unit">120.0</field>
                <field
                    name="date_start"
                    eval="(datetime.datetime.now()).strftime('%Y-%m-%d')"
                />
                <field
                    name="recurring_next_date"
                    eval="(datetime.datetime.now()).strftime('%Y-%m-%d')"
                />
                <field name="recurring_rule_type">monthly</field>
                <field name="property_id" ref="pms_base.demo_property_downtown" />
            </record>
        </field>
    </record>

    <record id="demo_contract_suburban" model="contract.contract">
        <field name="name">Suburban House – Services Contract</field>
        <field name="partner_id" ref="pms_base.demo_partner_owner" />
        <field name="contract_line_ids">
            <record id="demo_contract_line_laundry" model="contract.line">
                <field name="name">Linen Service</field>
                <field name="product_id" ref="pms_base.demo_product_laundry" />
                <field name="quantity">1.0</field>
                <field name="price_unit">35.0</field>
                <field
                    name="date_start"
                    eval="(datetime.datetime.now()).strftime('%Y-%m-%d')"
                />
                <field
                    name="recurring_next_date"
                    eval="(datetime.datetime.now()).strftime('%Y-%m-%d')"
                />
                <field name="recurring_rule_type">monthly</field>
                <field name="property_id" ref="pms_base.demo_property_suburban" />
            </record>
        </field>
    </record>
</odoo>
