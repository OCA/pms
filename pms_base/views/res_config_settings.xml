<odoo>
    <record id="view_res_config_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pms</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="40" />
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
                    string="Properties"
                    data-string="Property Management System"
                    name="pms_base"
                    groups="pms_base.group_pms_manager"
                >
                    <block title="Property Information" id="characteristics">
                        <setting
                            string="Area (UoM)"
                            help="Define your unit of measure when entering area"
                        >
                            <field name="pms_uom" widget="radio" />
                        </setting>
                        <setting
                            string="Show Amenities"
                            help="Manage amenities related to your properties"
                        >
                            <field name="group_pms_show_amenity" />
                        </setting>
                        <setting
                            string="Show Rooms"
                            help="Manage rooms of your properties"
                        >
                            <field name="group_pms_show_room" />
                        </setting>
                        <setting
                            string="Show Services"
                            help="Manage services available at your properties"
                        >
                            <field name="group_pms_show_service" />
                        </setting>
                        <setting
                            string="Show Teams"
                            help="Split your properties by Team"
                        >
                            <field name="group_pms_show_team" />
                        </setting>
                        <setting
                            string="Link to Projects"
                            help="Link projects and tasks to your properties"
                        >
                            <field name="module_pms_project" />
                        </setting>
                        <setting
                            string="Link to Purchases"
                            help="Link purchases to your properties"
                        >
                            <field name="module_pms_purchase" />
                        </setting>
                        <setting
                            string="Manage Content"
                            help="Link a property to a stock location"
                        >
                            <field name="module_pms_stock" />
                        </setting>
                    </block>
                    <block title="Accounting" id="account">
                        <setting
                            string="Manage Accounting"
                            help="Manage accounting related information"
                        >
                            <field name="module_pms_account" />
                        </setting>
                        <setting
                            string="Manage Depreciation and Amortization"
                            help="Manage assets related to your properties"
                        >
                            <field name="module_pms_account_asset" />
                        </setting>
                        <setting
                            string="Manage Contracts"
                            help="Manage utility contracts and others recurring invoices/bills"
                        >
                            <field name="module_pms_contract" />
                        </setting>
                    </block>
                    <block title="Reservations" id="sale">
                        <setting
                            string="Manage Reservations"
                            help="Manage reservations"
                        >
                            <field name="module_pms_sale" />
                        </setting>
                        <setting string="CRM" help="Link your leads to a property">
                            <field name="module_pms_crm" />
                        </setting>
                        <setting
                            string="Website"
                            help="Publish your properties on your website"
                        >
                            <field name="module_pms_website" />
                        </setting>
                        <setting
                            string="Online reservation"
                            help="Allow customers to book reservations online"
                        >
                            <field name="module_pms_website_sale" />
                        </setting>
                    </block>
                    <block title="Integrations" id="connect">
                        <setting
                            string="Connect with Guesty"
                            help="Publish properties to https://guesty.com and get reservations"
                        >
                            <field name="module_connector_guesty" />
                        </setting>
                        <setting
                            string="Connect with Wubook"
                            help="Publish properties to https://wubook.com and get reservations"
                        >
                            <field name="module_connector_wubook" />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_pms_config" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'pms_base'}</field>
    </record>
</odoo>
