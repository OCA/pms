<?xml version="1.0" encoding="utf-8" ?>
<templates xml:space="preserve">
    <t t-inherit="web_timeline.TimelineRenderer" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('oe_timeline_buttons')]" position="inside">
            <div
                t-if="pmsFilter"
                class="d-flex align-items-center gap-2 ms-2 pms-timeline-filters"
            >
                <select class="o_input w-auto pms-city-select" t-model="pmsFilter.city">
                    <option value="">Select City</option>
                    <option
                        t-foreach="pmsFilter.cities"
                        t-as="city"
                        t-key="city"
                        t-att-value="city"
                        t-out="city"
                    />
                </select>
                <div class="d-flex align-items-center gap-1 pms-date-range">
                    <input
                        class="o_input pms-date-from"
                        t-ref="pms-date-from"
                        placeholder="From"
                    />
                    <i class="fa fa-long-arrow-right" aria-hidden="true" />
                    <input
                        class="o_input pms-date-to"
                        t-ref="pms-date-to"
                        placeholder="To"
                    />
                </div>
                <input
                    type="number"
                    min="0"
                    class="o_input w-auto pms-bedrooms"
                    placeholder="Bedrooms"
                    t-model.number="pmsFilter.bedrooms"
                />
                <button
                    class="btn btn-secondary pms-search"
                    t-on-click="_onPmsSearchClicked"
                >Search</button>
            </div>
        </xpath>
    </t>
</templates>
