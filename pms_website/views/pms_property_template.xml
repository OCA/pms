<odoo>
    <template id="property" name="Property" track="1">
        <t t-call="website.layout">
            <t t-set="additional_title" t-value="property.name" />
            <div
                class="oe_structure oe_empty"
                id="oe_structure_website_sale_property_1"
            />
            <div
                itemscope="itemscope"
                itemtype="http://schema.org/Product"
                id="wrap"
                class="js_sale"
            >
                <section
                    t-attf-class="container py-2 oe_website_sale"
                    id="product_detail"
                    t-att-data-view-track="view_track and '1' or '0'"
                >
                    <div class="row">
                        <div class="col-md-4">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a t-att-href="keep()">Properties</a>
                                </li>
                                <li class="breadcrumb-item active">
                                    <span t-field="property.name" />
                                </li>
                            </ol>
                        </div>
                        <div class="col-md-8">
                            <!-- <div class="form-inline justify-content-end">
                                <t t-call="website_sale.search">
                                    <t t-set="search" t-value="False"/>
                                </t>
                                <t t-call="website_sale.pricelist_list">
                                    <t t-set="_classes" t-valuef="ml-2"/>
                                </t>
                            </div> -->
                        </div>
                    </div>
                    <div
                        itemprop="description"
                        t-field="property.website_description1"
                        class="oe_structure oe_empty mt16"
                        id="oe_structure_website_sale_property_3"
                    />
                    <div class="row mb-4">
                        <div class="col-12">
                            <div
                                id="o-carousel-product"
                                class="ratio ratio-16x9 rounded overflow-hidden bg-light"
                            >
                                <div
                                    t-field="property.image_1920"
                                    class="d-flex align-items-center justify-content-center h-100"
                                    t-options='{"widget": "image", "preview_image": "image_1024", "class": "w-100 h-100 object-fit-cover", "alt-field": "name", "itemprop": "image"}'
                                />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 pt-2 pb-3" id="product_details">
                            <h1
                                itemprop="name"
                                t-field="property.name"
                            >Property Name</h1>
                            <span
                                itemprop="url"
                                style="display:none;"
                                t-esc="property.website_url"
                            />
                            <h4 class="mt-2 mb-0" t-if="property.partner_id">
                                <a
                                    itemprop="name"
                                    t-att-href="property.google_map_link()"
                                    target="_BLANK"
                                    class="text-decoration-none"
                                >
                                    <i class="fa fa-map-marker me-1" />
                                    <span t-field="property.city" />
                                </a>
                            </h4>
                            <h5 class="mt-2 text-muted" t-if="property.parent_id">
                                <i class="fa fa-building me-1" />
                                <span
                                    itemprop="parent_name"
                                    t-field="property.parent_id"
                                />
                            </h5>
                            <div class="mt-4">
                                <a href="/contactus" class="btn btn-primary">
                                    Contact us
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="row g-3 mb-4">
                        <div
                            class="col-sm-6 col-md-3"
                            t-if="show_rooms and property.qty_bedroom"
                        >
                            <div
                                class="d-flex align-items-center p-3 border rounded h-100"
                            >
                                <i class="fa fa-bed fa-2x text-muted me-3" />
                                <div>
                                    <div
                                        class="fs-4 fw-bold"
                                        t-esc="property.qty_bedroom"
                                    />
                                    <div class="text-muted">Bedrooms</div>
                                </div>
                            </div>
                        </div>
                        <div
                            class="col-sm-6 col-md-3"
                            t-if="show_rooms and property.qty_half_bathroom"
                        >
                            <div
                                class="d-flex align-items-center p-3 border rounded h-100"
                            >
                                <i class="fa fa-bath fa-2x text-muted me-3" />
                                <div>
                                    <div
                                        class="fs-4 fw-bold"
                                        t-esc="property.qty_half_bathroom"
                                    />
                                    <div class="text-muted">Bathrooms</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-3" t-if="property.area">
                            <div
                                class="d-flex align-items-center p-3 border rounded h-100"
                            >
                                <i class="fa fa-home fa-2x text-muted me-3" />
                                <div>
                                    <div class="fs-4 fw-bold">
                                        <span t-field="property.area" />
                                        <span class="fs-6 fw-normal"> m²</span>
                                    </div>
                                    <div class="text-muted">Area</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row mb-4" t-if="show_services and property.service_ids">
                        <div class="col-12">
                            <h5 class="mb-3">Services</h5>
                            <div class="row g-3">
                                <t
                                    t-foreach="property.sudo().service_ids"
                                    t-as="service"
                                >
                                    <div class="col-sm-6 col-md-4">
                                        <div
                                            class="d-flex align-items-center p-3 border rounded h-100"
                                        >
                                            <i
                                                t-attf-class="fa {{service.icon or 'fa-check'}} fa-lg text-muted me-3"
                                            />
                                            <span t-esc="service.name.name" />
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                    <div
                        t-if="show_rooms and property.parking_lot"
                        class="section-margin mt-3"
                    >
                        <ul class="list-group direction-vertical">
                            <li
                                class="sc-bBHxTw ljStsE list-group-item d-flex p-0  my-2 border-0"
                            >
                                <div class="pt-0 pr-3">
                                    <span class="fa fa-car" />
                                </div>
                                <div class="flex-grow-1">
                                    <div class="mb-1">
                                        <h5
                                            class="mb-0 item-header"
                                        >Parking Availability</h5>
                                    </div>
                                    <div class="mb-1">
                                        <p
                                            style="font-size: 15px; line-height:22px;"
                                        >Free parking spots nearby</p>
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </div>
                    <div
                        itemprop="description"
                        t-field="property.website_description2"
                        class="oe_structure oe_empty mt16"
                        id="oe_structure_website_sale_property_4"
                    />
                </section>
                <section class="row section-margin">
                    <div class="col-12">
                        <section class="container">
                            <ul
                                class="list-group direction-horizontal row"
                                style="flex-direction: row !important; flex-wrap: wrap;"
                            >
                                <li
                                    class="list-group-item d-flex p-0 col col-sm-6 col-md-4 p-3 my-2 border-0"
                                >
                                    <div class="pt-0 pe-3">
                                        <i class="fa fa-clock-o fa-lg" />
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="mb-1">
                                            <p
                                                class="mb-0 item-header"
                                            > Check in &amp; Check out </p>
                                        </div>
                                        <div class="mb-1">
                                            <p
                                                class="text-justify"
                                            >Please contact the property manager for check-in and check-out times.</p>
                                        </div>
                                    </div>
                                </li>

                                <li
                                    class="list-group-item d-flex p-0 col col-sm-6 col-md-4 p-3 my-2 border-0"
                                >
                                    <div class="pt-0 pe-3">
                                        <i class="fa fa-check-square-o fa-lg" />
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="mb-1">
                                            <p
                                                class="mb-0 item-header"
                                            > House Rules </p>
                                        </div>
                                        <div class="mb-1">
                                            <div class="d-flex justify-content-between">
                                                <div>
                                                    <t t-if="property.pets">
                                                        <span class="fa fa-circle-o" />
                                                        <span
                                                            class="normal"
                                                        >Pet-friendly apartments.</span>
                                                    </t>
                                                    <t t-elif="property.pets== False">
                                                        <span class="fa fa-circle-o" />
                                                        <span
                                                            class="normal"
                                                        >Pets Are  Not Allowed.</span>
                                                    </t>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </li>

                                <li
                                    class="list-group-item d-flex p-0 col col-sm-6 col-md-4 p-3 my-2 border-0"
                                >
                                    <div class="pt-0 pe-3">
                                        <i class="fa fa-times-circle-o fa-lg" />
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="mb-1">
                                            <p
                                                class="mb-0 item-header"
                                            > Cancelation Policy </p>
                                        </div>
                                        <div class="mb-1">
                                            <div class="d-flex justify-content-between">
                                                <div>
                                                    <p
                                                        class="text-justify"
                                                    >Change of plans? No worries. You can cancel up to 72 hours before your check-in date for a full refund. For reservations close to check-in or special cases, please contact our team, we will be glad to help.</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </li>
                            </ul>
                        </section>
                    </div>
                </section>
                <section
                    t-attf-class="container py-4 oe_website_sale"
                    id="property_amenities"
                    t-if="show_amenities and property.amenity_ids"
                    t-att-data-view-track="view_track and '1' or '0'"
                >
                    <t
                        t-set="main_amenities"
                        t-value="property.amenity_ids.filtered(lambda amenity: amenity.is_main_amenity)"
                    />
                    <t
                        t-if="not main_amenities"
                        t-set="main_amenities"
                        t-value="property.amenity_ids"
                    />
                    <t
                        t-set="other_amenities"
                        t-value="property.amenity_ids.filtered(lambda amenity: not amenity.is_main_amenity)"
                    />
                    <h2 class="text-center mb-4">Amenities</h2>
                    <div class="row g-3">
                        <t t-foreach="main_amenities" t-as="amenity">
                            <div class="col-sm-6 col-md-4">
                                <div
                                    class="d-flex align-items-center p-3 border rounded h-100"
                                >
                                    <i class="fa fa-check-circle text-success me-3" />
                                    <span t-esc="amenity.name" />
                                </div>
                            </div>
                        </t>
                    </div>
                    <div class="row mt-4" t-if="other_amenities">
                        <div class="col-12 text-center">
                            <button
                                type="button"
                                class="btn btn-outline-dark px-4"
                                data-bs-toggle="modal"
                                data-bs-target="#propertyAmenitiesModal"
                            >
                                Explore all amenities
                            </button>
                        </div>
                    </div>
                </section>

                <!-- Anchor for pms_website_sale.property_booking_form xpath -->
                <div
                    class="modal fade right d-none"
                    id="exampleModalPreview"
                    aria-hidden="true"
                    tabindex="-1"
                />

                <div
                    class="modal fade"
                    id="propertyAmenitiesModal"
                    tabindex="-1"
                    aria-labelledby="propertyAmenitiesModalLabel"
                    aria-hidden="true"
                >
                    <div class="modal-dialog modal-lg modal-dialog-scrollable">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h3
                                    class="modal-title"
                                    id="propertyAmenitiesModalLabel"
                                >
                                    All Amenities
                                </h3>
                                <button
                                    type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Close"
                                />
                            </div>
                            <div class="modal-body">
                                <p class="text-muted mb-4">
                                    Explore all amenities available in this property.
                                </p>
                                <div class="row g-3">
                                    <t t-foreach="property.amenity_ids" t-as="amenity">
                                        <div class="col-sm-6 col-md-4">
                                            <div
                                                class="d-flex align-items-center p-3 border rounded h-100"
                                            >
                                                <i
                                                    class="fa fa-check-circle text-success me-3"
                                                />
                                                <span t-esc="amenity.name" />
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div
                class="oe_structure oe_empty"
                id="oe_structure_website_sale_property_2"
            />
        </t>
    </template>

    <template id="properties" name="Properties">
        <t t-call="website.layout">
            <t t-set="additional_title">Properties</t>
            <div id="wrap">
                <section class="container py-5">
                    <div class="row mb-4">
                        <div class="col-12 text-center">
                            <h1>Properties</h1>
                            <p class="lead text-muted mb-0">
                                Browse our available properties and find your next stay.
                            </p>
                        </div>
                    </div>
                    <div class="row mb-4">
                        <div class="col-12">
                            <form
                                method="get"
                                action="/properties"
                                class="row g-3 align-items-end"
                            >
                                <div class="col-md-3">
                                    <label
                                        class="form-label"
                                        for="property_filter_city"
                                    >
                                        City
                                    </label>
                                    <select
                                        id="property_filter_city"
                                        name="city"
                                        class="form-select"
                                    >
                                        <option value="">All cities</option>
                                        <t t-foreach="cities" t-as="city_option">
                                            <option
                                                t-att-value="city_option"
                                                t-att-selected="selected_city == city_option and 'selected' or None"
                                                t-esc="city_option"
                                            />
                                        </t>
                                    </select>
                                </div>
                                <div class="col-md-3" t-if="show_rooms">
                                    <label
                                        class="form-label"
                                        for="property_filter_bedrooms"
                                    >
                                        Bedrooms
                                    </label>
                                    <select
                                        id="property_filter_bedrooms"
                                        name="bedrooms"
                                        class="form-select"
                                    >
                                        <option value="">Any bedrooms</option>
                                        <t
                                            t-foreach="bedrooms_options"
                                            t-as="bedroom_option"
                                        >
                                            <option
                                                t-att-value="bedroom_option"
                                                t-att-selected="selected_bedrooms == str(bedroom_option) and 'selected' or None"
                                            >
                                                <t t-esc="bedroom_option" />
                                                <t
                                                    t-if="bedroom_option == 1"
                                                > bedroom</t>
                                                <t t-else=""> bedrooms</t>
                                            </option>
                                        </t>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label
                                        class="form-label"
                                        for="property_filter_category"
                                    >
                                        Category
                                    </label>
                                    <select
                                        id="property_filter_category"
                                        name="category"
                                        class="form-select"
                                    >
                                        <option value="">All categories</option>
                                        <t
                                            t-foreach="categories"
                                            t-as="category_option"
                                        >
                                            <option
                                                t-att-value="category_option.id"
                                                t-att-selected="selected_category == str(category_option.id) and 'selected' or None"
                                                t-esc="category_option.display_name"
                                            />
                                        </t>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label" for="property_filter_tag">
                                        Tag
                                    </label>
                                    <select
                                        id="property_filter_tag"
                                        name="tag"
                                        class="form-select"
                                    >
                                        <option value="">All tags</option>
                                        <t t-foreach="tags" t-as="tag_option">
                                            <option
                                                t-att-value="tag_option.id"
                                                t-att-selected="selected_tag == str(tag_option.id) and 'selected' or None"
                                                t-esc="tag_option.display_name"
                                            />
                                        </t>
                                    </select>
                                </div>
                                <div class="col-12 d-flex gap-2">
                                    <button type="submit" class="btn btn-primary">
                                        Filter
                                    </button>
                                    <a href="/properties" class="btn btn-link">
                                        Clear
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>
                    <div class="row g-4" t-if="properties">
                        <t t-foreach="properties" t-as="property">
                            <div class="col-md-6 col-lg-4">
                                <div class="card h-100 shadow-sm border-0">
                                    <a
                                        t-att-href="property.website_url"
                                        class="text-decoration-none text-reset"
                                    >
                                        <div
                                            class="ratio ratio-4x3 bg-light overflow-hidden rounded-top"
                                        >
                                            <img
                                                t-att-src="website.image_url(property, 'image_512')"
                                                t-att-alt="property.name"
                                                class="w-100 h-100 object-fit-cover"
                                            />
                                        </div>
                                        <div class="card-body">
                                            <h5
                                                class="card-title mb-2"
                                                t-field="property.name"
                                            />
                                            <p
                                                class="card-text text-muted mb-2"
                                                t-if="property.city"
                                            >
                                                <i class="fa fa-map-marker me-1" />
                                                <span t-field="property.city" />
                                            </p>
                                            <div
                                                class="d-flex flex-wrap gap-2 text-muted small"
                                            >
                                                <span
                                                    t-if="show_rooms and property.qty_bedroom"
                                                >
                                                    <i class="fa fa-bed me-1" />
                                                    <t
                                                    t-esc="property.qty_bedroom"
                                                /> bedrooms
                                                </span>
                                                <span t-if="property.area">
                                                    <i class="fa fa-home me-1" />
                                                    <span t-field="property.area" />
                                                    m²
                                                </span>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            </div>
                        </t>
                    </div>
                    <div class="alert alert-info mt-4" t-if="not properties">
                        No published properties are available right now.
                    </div>
                    <div class="d-flex justify-content-center mt-4" t-if="pager">
                        <t t-call="website.pager" />
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
