    <!-- Commercial inventory. The effective limit of a night is the lowest
         one across the scopes that apply, so Booking.com can sell at most 1
         double per night even though the property puts 2 on sale.

         The two rules below open the year with no limit, which is how a
         property starts, and the ones after them are written on top: within
         the same scope the overlap is resolved when reading and the rule
         written last wins, so the season does not have to be cut up to
         change a fortnight. -->
    <record id="demo_inventory_rule_double_year" model="pms.inventory.rule">
        <field name="pms_property_id" ref="main_pms_property" />
        <field name="room_type_id" ref="pms_room_type_double" />
        <field name="date_from" eval="DateTime.today()" />
        <field name="date_to" eval="DateTime.today() + timedelta(365)" />
        <field name="quota">-1</field>
        <field name="max_avail">-1</field>
    </record>
    <record id="demo_inventory_rule_triple_year" model="pms.inventory.rule">
