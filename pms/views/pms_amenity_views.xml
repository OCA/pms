<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="pms_amenity_view_form" model="ir.ui.view">
        <field name="name">pms.amenity.form</field>
        <field name="model">pms.amenity</field>
        <field name="arch" type="xml">
            <form string="Room Amenities">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <div class="oe_title">
                        <label for="name" string="Amenity" />
                        <h1>
                            <field name="name" placeholder="Amenity..." />
                        </h1>
                    </div>
                    <group>
                        <field name="default_code" />
                    </group>
                    <notebook>
                        <page string="Information">
                            <group>
                                <field
                                    name="pms_property_ids"
                                    widget="many2many_tags"
                                    options="{'no_create': True,'no_open': True}"
                                />
                                <field
                                    name="pms_amenity_type_id"
                                    string="Amenity Type"
                                    domain="['|', ('pms_property_ids', '=', False), ('pms_property_ids', 'in', pms_property_ids)]"
                                />
                                <field name="is_add_code_room_name" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <record id="pms_amenity_search" model="ir.ui.view">
        <field name="name">pms.room_amenity_search</field>
        <field name="model">pms.amenity</field>
        <field name="arch" type="xml">
            <search string="Room Amenities">
                <field name="name" />
                <field name="pms_amenity_type_id" />
            </search>
        </field>
    </record>
    <record id="pms_amenity_view_list" model="ir.ui.view">
        <field name="name">pms.room_amenity_list</field>
        <field name="model">pms.amenity</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="pms_amenity_type_id" optional="show" />
                <field name="default_code" optional="show" />
                <field name="is_add_code_room_name" optional="show" />
            </list>
        </field>
    </record>
    <record id="action_pms_room_amenity_view_form" model="ir.actions.act_window">
        <field name="name">Room Amenities</field>
        <field name="res_model">pms.amenity</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="pms_amenity_view_list" />
    </record>
    <menuitem
        id="menu_amenity"
        name="Amenity"
        parent="pms.pms_configuration_menu"
        sequence="55"
    />
    <menuitem
        name="Amenities"
        id="menu_action_pms_room_amenity_view_form"
        action="action_pms_room_amenity_view_form"
        sequence="5"
        parent="pms.menu_amenity"
    />
</odoo>
