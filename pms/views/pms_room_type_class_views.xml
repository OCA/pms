<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="pms_room_type_class_view_form" model="ir.ui.view">
        <field name="name">pms.room.type.class.form</field>
        <field name="model">pms.room.type.class</field>
        <field name="arch" type="xml">
            <form string="Room Class">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <div class="oe_button_box" name="button_box" />
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="default_code" />
                            <field
                                name="pms_property_ids"
                                widget="many2many_tags"
                                options="{'no_create': True,'no_open': True}"
                            />
                            <field name="overnight" />
                        </group>
                        <group />
                    </group>
                    <notebook>
                        <page string="Room Type">
                            <field name="room_type_ids" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="pms_room_type_class_view_list" model="ir.ui.view">
        <field name="name">pms.room.type.class.list</field>
        <field name="model">pms.room.type.class</field>
        <field name="arch" type="xml">
            <list name="Room Class">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="default_code" optional="show" />
                <field name="room_type_ids" widget="many2many_tags" optional="show" />
            </list>
        </field>
    </record>
    <record model="ir.actions.act_window" id="open_pms_room_type_class_form_list">
        <field name="name">Room Type Class</field>
        <field name="res_model">pms.room.type.class</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        name="Room Type Class"
        id="menu_open_pms_room_type_class_form_list"
        action="open_pms_room_type_class_form_list"
        sequence="25"
        parent="pms.pms_rooms_menu"
    />
</odoo>
