<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--==== Amenities Type ==== -->
    <!-- Form view of pms room amenities type -->
    <record id="pms_room_amenity_type_view_form" model="ir.ui.view">
        <field name="name">pms.room_amenity_type_form</field>
        <field name="model">pms.amenity.type</field>
        <field name="arch" type="xml">
            <form string="Room Amenities Type">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Amenity Type" />
                        <h1>
                            <field name="name" placeholder="Amenity Type..." />
                        </h1>
                    </div>
                    <group>
                        <field
                            name="pms_property_ids"
                            widget="many2many_tags"
                            options="{'no_create': True,'no_open': True}"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- List view of pms room amenities type -->
    <record id="pms_room_amenity_type_view_list" model="ir.ui.view">
        <field name="name">pms.room_amenity_type_list</field>
        <field name="model">pms.amenity.type</field>
        <field name="arch" type="xml">
            <list name="Room Amenities Type">
                <field name="name" />
                <field name="pms_property_ids" widget="many2many_tags" />
            </list>
        </field>
    </record>
    <!-- Action for pms room amenities type -->
    <record id="action_pms_room_amenity_type_view_form" model="ir.actions.act_window">
        <field name="name">Room Amenity Type</field>
        <field name="res_model">pms.amenity.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        name="Amenity Types"
        id="menu_action_pms_room_amenity_type_view_form"
        action="action_pms_room_amenity_type_view_form"
        sequence="15"
        parent="pms.menu_amenity"
    />
</odoo>
