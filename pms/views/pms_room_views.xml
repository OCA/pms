                                        />
                                        <field
                                            name="zip"
                                            placeholder="ZIP"
                                            class="o_address_zip"
                                        />
                                        <field
                                            name="country_id"
                                            placeholder="Country"
                                            class="o_address_country"
                                            options='{"no_open": True, "no_create": True}'
                                        />
                                    </div>
                                    <field
                                        name="website"
                                        widget="url"
                                        placeholder="e.g. https://www.odoo.com"
                                    />
                                </group>
                                <group />
                            </group>
                        </page> -->
                        <!-- <page
                            string="Shared Room"
                            invisible="not is_shared_room"
                        >
