<?xml version="1.0" ?>
<odoo>
    <record id="availability_plan_rule_view_form" model="ir.ui.view">
        <field name="name">pms.availability.plan.rule.form</field>
        <field name="model">pms.availability.plan.rule</field>
        <field name="arch" type="xml">
            <form string="Availability Plans">
                <group>
                    <field name="room_type_id" required="True" />
                    <field name="date" />
                </group>
                <group>
                    <group>
                        <field name="min_stay" />
                        <field name="min_stay_arrival" />
                        <field name="quota" />
                        <field name="max_avail" />
                        <field
                            name="pms_property_id"
                            options="{'no_create': True,'no_open': True}"
                        />
                    </group>
                    <group>
                        <field name="max_stay" />
                        <field name="max_stay_arrival" />
                        <field name="closed" />
                        <field name="closed_departure" />
                        <field name="closed_arrival" />
                    </group>
                </group>
            </form>
        </field>
    </record>
    <record id="availability_plan_rule_view_list" model="ir.ui.view">
        <field name="name">pms.availability.plan.rule.list</field>
        <field name="model">pms.availability.plan.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="availability_plan_id" />
                <field name="date" />
                <field name="room_type_id" optional="show" />
                <field name="quota" optional="show" />
                <field name="max_avail" optional="show" />
                <field name="min_stay" optional="show" />
                <field name="max_stay" optional="show" />
                <field name="min_stay_arrival" optional="show" />
                <field name="max_stay_arrival" optional="show" />
                <field name="closed" optional="show" />
                <field name="closed_arrival" optional="show" />
                <field name="closed_departure" optional="show" />
                <field name="pms_property_id" optional="show" />
            </list>
        </field>
    </record>
    <record id="availability_plan_rule_view_list_action" model="ir.actions.act_window">
        <field name="name">Availability Plan Rules</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">pms.availability.plan.rule</field>
        <field name="context">{'group_by':'availability_plan_id'}</field>
        <field name="view_id" ref="availability_plan_rule_view_list" />
        <field name="view_mode">list</field>
    </record>
</odoo>
