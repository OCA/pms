<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="pms_room_closure_reason_view_form" model="ir.ui.view">
        <field name="name">pms.room.closure.reason.form</field>
        <field name="model">room.closure.reason</field>
        <field name="arch" type="xml">
            <form string="Room Closure Reason">
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="description" />
                            <field
                                name="pms_property_ids"
                                widget="many2many_tags"
                                options="{'no_create': True,'no_open': True}"
                            />
                        </group>
                        <group />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="pms_room_closure_reason_view_list" model="ir.ui.view">
        <field name="name">pms.room.closure.reason.list</field>
        <field name="model">room.closure.reason</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="description" />
            </list>
        </field>
    </record>
    <record model="ir.actions.act_window" id="open_pms_room_closure_reason_form_list">
        <field name="name">Room Closure Reason</field>
        <field name="res_model">room.closure.reason</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        name="Closure Reasons"
        id="menu_pms_room_closure_reason_form_list"
        action="open_pms_room_closure_reason_form_list"
        sequence="25"
        parent="pms.pms_configuration_menu"
    />
</odoo>
