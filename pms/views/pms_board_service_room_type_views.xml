<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="pms_board_service_room_type_form" model="ir.ui.view">
        <field name="name">pms.board.service.room.type.form</field>
        <field name="model">pms.board.service.room.type</field>
        <field name="arch" type="xml">
            <form string="Board Service Line">
                <group>
                    <field name="amount" />
                    <field name="pms_property_id" />
                    <notebook>
                        <page name="board_service_line" string="Lines">
                            <field name="board_service_line_ids">
                                <list editable="bottom">
                                    <field
                                        name="pms_board_service_room_type_id"
                                        column_invisible="1"
                                    />
                                    <field name="product_id" />
                                    <field name="amount" />
                                    <field name="adults" />
                                    <field name="children" />
                                    <field
                                        name="pms_property_id"
                                        column_invisible="1"
                                    />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </group>
            </form>
        </field>
    </record>
    <record id="action_pms_board_service_room_type_view" model="ir.actions.act_window">
        <field name="name">Board Service</field>
        <field name="res_model">pms.board.service.room.type</field>
        <field name="view_mode">form</field>
    </record>
</odoo>
