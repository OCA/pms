<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="pms_ubication_view_form" model="ir.ui.view">
        <field name="name">pms.ubication.form</field>
        <field name="model">pms.ubication</field>
        <field name="arch" type="xml">
            <form string="Property Ubication">
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <field name="sequence" />
                        <field
                            name="pms_property_ids"
                            widget="many2many_tags"
                            options="{'no_create': True,'no_open': True}"
                        />
                    </group>
                    <notebook>
                        <page name="pms_rooms" string="Rooms">
                            <field name="pms_room_ids" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="pms_ubication_view_list" model="ir.ui.view">
        <field name="name">pms.ubication.tree</field>
        <field name="model">pms.ubication</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field
                    name="pms_property_ids"
                    widget="many2many_tags"
                    optional="show"
                />
                <field name="pms_room_ids" widget="many2many_tags" optional="show" />
                <field name="sequence" optional="show" />
            </list>
        </field>
    </record>
    <record id="open_pms_ubication_form_list" model="ir.actions.act_window">
        <field name="name">Ubication Structure</field>
        <field name="res_model">pms.ubication</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        name="Ubications"
        id="menu_open_pms_ubication_form_list"
        action="open_pms_ubication_form_list"
        sequence="65"
        parent="pms.pms_rooms_menu"
    />
</odoo>
