<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="pms_board_service_form" model="ir.ui.view">
        <field name="name">pms.board.service.form</field>
        <field name="model">pms.board.service</field>
        <field name="arch" type="xml">
            <form string="Board Service Line">
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="default_code" />
                            <field
                                name="pms_property_ids"
                                widget="many2many_tags"
                                options="{'no_create': True,'no_open': True}"
                            />
                        </group>
                        <group>
                            <field name="show_detail_report" />
                        </group>
                    </group>
                    <notebook>
                        <page name="board_service" string="Lines">
                            <field name="board_service_line_ids">
                                <list editable="bottom">
                                    <field name="product_id" />
                                    <field name="amount" sum="total" />
                                    <field name="adults" />
                                    <field name="children" />
                                    <field
                                        name="pms_property_ids"
                                        column_invisible="1"
                                    />
                                </list>
                            </field>
                            <group class="oe_subtotal_footer" name="pms_board_total">
                                <div class="oe_inline o_td_label">
                                    <label for="amount" />
                                </div>
                                <field
                                    name="amount"
                                    nolabel="1"
                                    class="oe_subtotal_footer_separator"
                                />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="pms_board_service_view_list" model="ir.ui.view">
        <field name="name">pms.board.service.list</field>
        <field name="model">pms.board.service</field>
        <field name="arch" type="xml">
            <list name="Board Services">
                <field name="name" />
                <field name="default_code" />
                <field name="amount" />
                <field name="show_detail_report" optional="show" />
                <field
                    name="pms_property_ids"
                    widget="many2many_tags"
                    optional="show"
                />
            </list>
        </field>
    </record>
    <record id="open_pms_board_service_form_list" model="ir.actions.act_window">
        <field name="name">Board Services</field>
        <field name="res_model">pms.board.service</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        name="Board Services"
        id="menu_open_pms_board_service_form_list"
        action="open_pms_board_service_form_list"
        sequence="25"
        parent="pms.pms_services_menu"
    />
</odoo>
